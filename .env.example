# GEMINI_API_KEY: Required for Gemini Interactions API video generation (gemini-omni-1.2-flash).
# Note: Firebase AI Logic features (Gemini 3.8 Flash translation & Nano Banana 2.1 image studio)
# authenticate automatically via Firebase App Check and do not use this key.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY
